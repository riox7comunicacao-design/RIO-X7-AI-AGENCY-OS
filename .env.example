# Fundação de autenticação (Passo 0009.6 / docs/decisions/0010-auth-foundation.md).
# Nenhum valor real existe neste passo — nenhum projeto Supabase foi criado.
# Copie este arquivo para .env (já ignorado pelo Git) e preencha quando o
# projeto Supabase existir. NUNCA coloque valores reais neste arquivo
# (.env.example é versionado), só em .env.

# URL do projeto Supabase (ex.: https://xxxxx.supabase.co)
SUPABASE_URL=

# Chave pública "anon" do Supabase — segura para uso no cliente/frontend,
# nunca a service role key.
SUPABASE_ANON_KEY=

# A service role key do Supabase NUNCA deve ser exposta ao frontend e nunca
# deve entrar neste arquivo de exemplo nem em nenhum arquivo versionado.
# Quando necessária (só em código de servidor), deve vir de uma variável de
# ambiente própria, configurada fora do repositório.

# --- Opcional: teste de integração com token REAL (somente leitura) ---------
# tests/auth/identity-verification.test.js ([REAL-2]) só executa o caso positivo
# se esta variável existir no ambiente; sem ela o teste fica explicitamente
# PENDENTE (skip). Use o access token de curta duração de um usuário de TESTE,
# nunca de um usuário real. Prefira exportá-la só na sessão do terminal, para
# uma execução; não a grave em arquivo versionado nem imprima/registre o valor.
# RIO_X7_TEST_ACCESS_TOKEN=
