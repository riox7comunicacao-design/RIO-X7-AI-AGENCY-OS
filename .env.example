# Configuração local do Rio X7 AI Agency OS (decisões 0010 e 0011).
# Copie este arquivo para .env (já ignorado pelo Git) e preencha SÓ as duas
# variáveis obrigatórias abaixo (SUPABASE_URL e SUPABASE_ANON_KEY) com os valores
# do projeto Supabase da Rio X7 (painel do Supabase -> Project Settings -> API).
# NUNCA coloque valores reais neste arquivo (.env.example é versionado), só em
# .env — que também nunca vai para o Git. O passo a passo completo para um
# computador novo está em docs/operations/MULTICOMPUTER-HANDOFF.md.

# URL do projeto Supabase (ex.: https://xxxxx.supabase.co)
SUPABASE_URL=

# Chave pública "anon" do Supabase — segura para uso no cliente/frontend,
# nunca a service role key.
SUPABASE_ANON_KEY=

# A service role key do Supabase NUNCA deve ser exposta ao frontend e nunca
# deve entrar neste arquivo de exemplo nem em nenhum arquivo versionado.
# Quando necessária (só em código de servidor), deve vir de uma variável de
# ambiente própria, configurada fora do repositório.

# --- Dashboard MVP / servidor (src/server) ----------------------------------
# Onde o servidor escuta. Padrões: 127.0.0.1:3000 (só a própria máquina).
# PORT=3000
# HOST=127.0.0.1

# Arquivo com os usuários Rio X7 (userId, authUserId, name, email, role,
# status — o formato de defineUser(), sem "permissions": elas vêm da role).
# NUNCA versionado (data/*.json já está no .gitignore). Sem este arquivo o
# servidor não inicia. Nenhum usuário é criado automaticamente. Exemplo:
#   [
#     { "userId": "breno", "authUserId": "<uuid do usuário no Supabase Auth>",
#       "name": "Breno Bento", "email": "breno@example.test",
#       "role": "ADMIN", "status": "ACTIVE" }
#   ]
# RIO_X7_USERS_FILE=data/users.json

# Caminho da fila de aprovação. Padrão: o do domínio (data/approval-queue.json).
# Aponte para data/approval-queue.dev.json (scripts/seed-dev-queue.js) em
# desenvolvimento, para nunca misturar dados fictícios com a fila real.
# RIO_X7_QUEUE_PATH=data/approval-queue.json

# Caminho do arquivo do CRM (o adapter de arquivo local, de DESENVOLVIMENTO — não é a
# persistência de produção). Padrão: data/crm.json, criado no primeiro registro.
# data/*.json já está no .gitignore: prospects reais nunca entram no Git.
# RIO_X7_CRM_PATH=data/crm.json

# --- Opcional: teste de integração com token REAL (somente leitura) ---------
# tests/auth/identity-verification.test.js ([REAL-2]) só executa o caso positivo
# se esta variável existir no ambiente; sem ela o teste fica explicitamente
# PENDENTE (skip). Use o access token de curta duração de um usuário de TESTE,
# nunca de um usuário real. Prefira exportá-la só na sessão do terminal, para
# uma execução; não a grave em arquivo versionado nem imprima/registre o valor.
# RIO_X7_TEST_ACCESS_TOKEN=
